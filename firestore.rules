rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, displayName, email, photoURL, role
    //
    // Collection: players
    // Fields: name, role, battingStyle, bowlingStyle, createdBy
    //
    // Collection: teams
    // Fields: name, logo, players, createdBy
    //
    // Collection: tournaments
    // Fields: name, organizer, teams, createdBy
    //
    // Collection: matches
    // Fields: teamA, teamB, status, tossWinner, tossDecision, overs, scoreA, scoreB, createdBy
    //
    // Collection: notifications
    // Fields: userId, title, message, type, read, matchId, timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "sallukhan54154@gmail.com" && request.auth.token.email_verified == true));
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.displayName is string && data.displayName.size() > 0 &&
             data.email is string && data.email.size() > 0;
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['name', 'role', 'createdBy']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.role in ['Batsman', 'Bowler', 'All-rounder', 'Wicket-keeper'] &&
             data.createdBy == request.auth.uid;
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['name', 'createdBy']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.createdBy == request.auth.uid;
    }

    function isValidTournament(data) {
      return data.keys().hasAll(['name', 'createdBy']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.createdBy == request.auth.uid;
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['teamA', 'teamB', 'status', 'createdBy']) &&
             data.teamA is string && data.teamB is string &&
             data.status in ['upcoming', 'live', 'completed'] &&
             (data.createdBy == request.auth.uid || isAdmin());
    }

    function isValidBall(data) {
      return data.keys().hasAll(['innings', 'over', 'ball', 'runs', 'timestamp']) &&
             data.innings is number && data.over is number && data.ball is number &&
             data.runs is number && data.timestamp is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'timestamp']) &&
             data.userId is string && data.title is string && data.message is string &&
             data.type in ['match_start', 'wicket', 'milestone', 'match_end', 'system'] &&
             data.read is bool && data.timestamp is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data);
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidPlayer(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidPlayer(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidTeam(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidTeam(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidTournament(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidTournament(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidMatch(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidMatch(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();

      match /balls/{ballId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidBall(request.resource.data) && 
                      get(/databases/$(database)/documents/matches/$(matchId)).data.createdBy == request.auth.uid;
        allow update, delete: if isAuthenticated() && 
                               get(/databases/$(database)/documents/matches/$(matchId)).data.createdBy == request.auth.uid;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated(); // Allow any authenticated user to create a notification (e.g. for another user)
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}
